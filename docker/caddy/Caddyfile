{
  admin 127.0.0.1:2019
  grace_period 5s
  email infra@revealmarket.xyz
  acme_ca https://acme-v02.api.letsencrypt.org/directory
}

(health_common) {
  @healthz path /healthz
  respond @healthz "ok" 200
}

(block_internal) {
  @internal path /internal/*
  respond @internal 404
}

(block_metrics) {
  @metrics path /metrics
  respond @metrics 404
}

(header_common) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
    -Server
  }
}

(cache_frontend) {
  header {
    Cache-Control "public, max-age=60"
  }
}

(cache_no_store) {
  header {
    Cache-Control "no-store"
  }
}

(maintenance_root) {
  root * /srv/maintenance
  rewrite * /maintenance.html
  file_server
}

(log_common) {
  log {
    level {$CADDY_LOG_LEVEL:INFO}
    output stdout
    format filter {
      wrap json
    }
  }
}

(access_log_json) {
  log {
    level {$CADDY_ACCESS_LOG_LEVEL:INFO}
    output stdout
    format filter {
      wrap json
    }
  }
}

(proxy_frontend) {
  reverse_proxy frontend:3000 {
    health_uri /
    health_interval 10s
    health_timeout 3s
    max_fails 2
    fail_duration 30s
    transport http {
      versions 1.1
      dial_timeout 5s
      read_timeout 30s
      write_timeout 30s
      max_conns_per_host 128
      keepalive_idle_conns 128
    }
    @frontend_down status 502 503 504
    handle_response @frontend_down {
      root * /srv/maintenance
      rewrite * /maintenance.html
      header Cache-Control "no-store"
      file_server
    }
  }
}

(proxy_api) {
  reverse_proxy api:8000 {
    health_uri /live
    health_headers {
      Host {$API_DOMAIN:api.revealmarket.xyz}
    }
    health_interval 10s
    health_timeout 3s
    max_fails 2
    fail_duration 30s
    transport http {
      versions 1.1
      keepalive_idle_conns 64
      read_timeout 60s
    }
    header_up Host {$API_DOMAIN:api.revealmarket.xyz}
  }
}

(proxy_streamer) {
  reverse_proxy streamer:8100 {
    health_uri /healthz
    health_headers {
      Host {$STREAM_DOMAIN:stream.revealmarket.xyz}
    }
    health_interval 10s
    health_timeout 3s
    max_fails 2
    fail_duration 30s
    transport http {
      versions 1.1
      keepalive_idle_conns 64
      read_timeout 60s
    }
    header_up Host {$STREAM_DOMAIN:stream.revealmarket.xyz}
  }
}

(tls_prod) {
  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    resolvers {$CADDY_DNS_RESOLVERS:1.1.1.1 1.0.0.1 8.8.8.8 8.8.4.4 9.9.9.9 149.112.112.112}
  }
}

(tls_local) {
  tls internal
}

# PRIMARY DOMAIN — revealmarket.xyz
revealmarket.xyz {
  encode zstd gzip
  import {$CADDY_TLS_PROFILE}
  import health_common
  import header_common
  import block_internal
  import log_common
  handle_path /artifacts/* {
    root * /srv/artifacts
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle_path /maintenance {
    import maintenance_root
  }
  import proxy_frontend
}

# STREAMER — stream.revealmarket.xyz
stream.revealmarket.xyz {
  encode zstd gzip
  import {$CADDY_TLS_PROFILE}
  import health_common
  import header_common
  import block_internal
  import block_metrics
  import cache_no_store
  import access_log_json
  import proxy_streamer
}

# API — api.revealmarket.xyz
api.revealmarket.xyz {
  encode zstd gzip
  import {$CADDY_TLS_PROFILE}
  import health_common
  import header_common
  import block_internal
  import block_metrics
  import cache_no_store
  import access_log_json
  import proxy_api
}

# WWW REDIRECT → apex
www.revealmarket.xyz {
  encode zstd gzip
  import {$CADDY_TLS_PROFILE}
  import health_common
  redir https://revealmarket.xyz{uri} 308
}
