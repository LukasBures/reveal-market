{
  # ======================================================================
  #  GLOBAL OPTIONS
  # ======================================================================

  # Disable the admin API for extra hardening (prevents local HTTP control)
  admin off

  # Allow graceful restarts and config reloads without dropping connections
  grace_period 5s

  # ----------------------------------------------------------------------
  #  Listener configuration
  #  NOTE: Only supported options for servers{} are used.
  # ----------------------------------------------------------------------
  servers :443 {
    # Enable modern HTTP protocols
    protocols h1 h2 h3

    # Protect against oversized request headers
    max_header_size 32kb
  }

  servers :80 {
    # HTTP/3 is not used on port 80
    protocols h1 h2
  }
}


# ======================================================================
#  PRIMARY DOMAIN — revealmarket.xyz
# ======================================================================
revealmarket.xyz {

  # Enable modern compression (zstd first, fallback gzip)
  encode zstd gzip

  # ------------------------------------------------------------------
  #  Limit request body size (20 MB) — correct location
  # ------------------------------------------------------------------
  request_body {
    max_size 20MB
  }

  # ------------------------------------------------------------------
  #  TLS HARDENING
  # ------------------------------------------------------------------
  tls {
    # Allow only TLS1.2+ (TLS1.3 preferred)
    protocols tls1.2 tls1.3

    # Strong ECDH curves for key exchange
    curves x25519 secp521r1 secp384r1

    # ACME certificate issuer settings
    issuer acme {
      email infra@revealmarket.xyz
    }
  }

  # ------------------------------------------------------------------
  #  SECURITY HEADERS
  # ------------------------------------------------------------------
  header {

    # Strict Transport Security with preload (2 years)
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # Prevent MIME-type sniffing
    X-Content-Type-Options "nosniff"

    # Limit referrer leakage
    Referrer-Policy "strict-origin-when-cross-origin"

    # Limit browser features
    Permissions-Policy "accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"

    # Clickjacking protection
    X-Frame-Options "DENY"

    # Short cache lifetime for HTML/API responses
    Cache-Control "public, max-age=60"

    # Remove the Server header to reduce fingerprinting
    -Server
  }

  # ------------------------------------------------------------------
  #  ACCESS LOGGING (using supported logfmt encoder)
  # ------------------------------------------------------------------
  log {
    output stdout

    # logfmt is supported, single_field is NOT
    format logfmt
  }

  # ------------------------------------------------------------------
  #  REVERSE PROXY TO FRONTEND
  # ------------------------------------------------------------------
  reverse_proxy frontend:3000 {

    # Preserve client info when passing to internal services
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {host}
    header_up X-Real-IP {remote_host}

    # Prevent attackers from spoofing proxy headers
    trusted_proxies private_ranges

    # Optimized HTTP transport for Docker internal calls
    transport http {
      versions h1 h2c             # Enable HTTP/2 to upstream
      keepalive_idle_conns 128
      keepalive_interval 60s
      read_buffer 4MiB
      write_buffer 4MiB
    }
  }
}


# ======================================================================
#  WWW REDIRECT — www.revealmarket.xyz → revealmarket.xyz
# ======================================================================
www.revealmarket.xyz {

  # Enable compression for redirect responses
  encode zstd gzip

  tls {
    protocols tls1.2 tls1.3
    issuer acme {
      email infra@revealmarket.xyz
    }
  }

  # Permanent redirect with 308 (RFC-recommended)
  redir https://revealmarket.xyz{uri} 308
}