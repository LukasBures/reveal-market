{
  logging {
    output stdout
    format single_field "{ts} | {level} | caddy | {msg}"
    level INFO
  }
  admin off
  grace_period 5s
  servers :443 {
    protocols h1 h2 h3
    max_header_size 32kb
    read_timeout 30s
    write_timeout 30s
    idle_timeout 120s
    request_body {
      max_size 20MB
    }
  }
  servers :80 {
    protocols h1 h2
    read_timeout 15s
    write_timeout 15s
    idle_timeout 60s
  }
}

revealmarket.xyz {
  encode zstd gzip
  tls {
    protocols tls1.2 tls1.3
    curves x25519 secp521r1 secp384r1
    issuer acme {
      email infra@revealmarket.xyz
    }
  }
  header {
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
    X-Frame-Options "DENY"
    Cache-Control "public, max-age=60"
    -Server
  }
  log {
    output stdout
    format single_field "{ts} | {level} | caddy.access | {request>remote_ip} | {request>method} {request>uri} {response>status} {size}B {duration}"
  }
  reverse_proxy frontend:3000 {
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {host}
    header_up X-Real-IP {remote_host}
    trusted_proxies private_ranges
    transport http {
      versions h1 h2c
      keepalive_idle_conns 128
      keepalive_interval 60s
      read_buffer 4MiB
      write_buffer 4MiB
    }
  }
}

www.revealmarket.xyz {
  encode zstd gzip
  tls {
    protocols tls1.2 tls1.3
  }
  redir https://revealmarket.xyz{uri} 308
}
