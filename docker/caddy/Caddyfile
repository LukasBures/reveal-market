{
  admin 127.0.0.1:2019
  grace_period 5s
  email infra@revealmarket.xyz
  acme_ca https://acme-v02.api.letsencrypt.org/directory
}

(health_common) {
  @healthz path /healthz
  respond @healthz "ok" 200
}

(header_common) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
    Expect-CT "max-age=86400, enforce"
    -Server
  }
}

(cache_frontend) {
  header {
    Cache-Control "public, max-age=60"
  }
}

(cache_no_store) {
  header {
    Cache-Control "no-store"
  }
}

(log_common) {
  log {
    level {$CADDY_LOG_LEVEL:INFO}
    output stdout
    format filter {
      wrap json
    }
  }
}

(access_log_json) {
  log {
    level {$CADDY_ACCESS_LOG_LEVEL:INFO}
    output stdout
    format filter {
      wrap json
    }
  }
}

(proxy_frontend) {
  reverse_proxy frontend:3000 {
    health_uri /
    health_interval 10s
    health_timeout 3s
    max_fails 2
    fail_duration 30s
    transport http {
      versions 1.1
      dial_timeout 5s
      read_timeout 30s
      write_timeout 30s
      max_conns_per_host 128
      keepalive_idle_conns 128
    }
  }
}

(proxy_api) {
  reverse_proxy api:8000 {
    health_uri /healthz
    health_headers {
      Host api.revealmarket.xyz
    }
    health_interval 10s
    health_timeout 3s
    max_fails 2
    fail_duration 30s
    transport http {
      versions 1.1
      keepalive_idle_conns 64
      read_timeout 60s
    }
    header_up Host api.revealmarket.xyz
  }
}

(proxy_streamer) {
  reverse_proxy streamer:8100 {
    health_uri /healthz
    health_headers {
      Host stream.revealmarket.xyz
    }
    health_interval 10s
    health_timeout 3s
    max_fails 2
    fail_duration 30s
    transport http {
      versions 1.1
      keepalive_idle_conns 64
      read_timeout 60s
    }
    header_up Host stream.revealmarket.xyz
  }
}

(tls_prod) {
  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    resolvers 1.1.1.1 1.0.0.1
  }
}

(tls_local) {
  tls internal
}

# PRIMARY DOMAIN — revealmarket.xyz
revealmarket.xyz {
  encode zstd gzip
  import {$CADDY_TLS_PROFILE}
  import health_common
  import header_common
  import cache_frontend
  import log_common
  import proxy_frontend
}

# STREAMER — stream.revealmarket.xyz
stream.revealmarket.xyz {
  encode zstd gzip
  import {$CADDY_TLS_PROFILE}
  import health_common
  import header_common
  import cache_no_store
  import access_log_json
  import proxy_streamer
}

# API — api.revealmarket.xyz
api.revealmarket.xyz {
  encode zstd gzip
  import {$CADDY_TLS_PROFILE}
  import health_common
  import header_common
  import cache_no_store
  import access_log_json
  import proxy_api
}

# WWW REDIRECT → apex
www.revealmarket.xyz {
  encode zstd gzip
  import {$CADDY_TLS_PROFILE}
  import health_common
  redir https://revealmarket.xyz{uri} 308
}
