{
  "uid": "rm-infrastructure",
  "title": "Infrastructure",
  "description": "PostgreSQL, Redis, and Prometheus infrastructure metrics",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d"]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "PostgreSQL",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Active Connections",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 7 },
      "id": 2,
      "datasource": null,
      "targets": [
        {
          "expr": "pg_stat_activity_count{job=\"postgres\"}",
          "legendFormat": "Active connections",
          "refId": "A"
        },
        {
          "expr": "pg_settings_max_connections{job=\"postgres\"}",
          "legendFormat": "Max connections",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "axisLabel": "connections"
          },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Max connections" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Active connections" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Transaction Rate",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 7 },
      "id": 3,
      "datasource": null,
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit_total{job=\"postgres\"}[5m])",
          "legendFormat": "Commits/s",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback_total{job=\"postgres\"}[5m])",
          "legendFormat": "Rollbacks/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "axisLabel": "tx/s"
          },
          "color": { "mode": "palette-classic" },
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Commits/s" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Rollbacks/s" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Tuple Operations",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 7 },
      "id": 4,
      "datasource": null,
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_inserted_total{job=\"postgres\"}[5m])",
          "legendFormat": "Inserted/s",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_tup_updated_total{job=\"postgres\"}[5m])",
          "legendFormat": "Updated/s",
          "refId": "B"
        },
        {
          "expr": "rate(pg_stat_database_tup_deleted_total{job=\"postgres\"}[5m])",
          "legendFormat": "Deleted/s",
          "refId": "C"
        },
        {
          "expr": "rate(pg_stat_database_tup_fetched_total{job=\"postgres\"}[5m])",
          "legendFormat": "Fetched/s",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisLabel": "tuples/s"
          },
          "color": { "mode": "palette-classic" },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "gauge",
      "title": "Cache Hit Ratio",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 6 },
      "id": 5,
      "datasource": null,
      "targets": [
        {
          "expr": "sum(pg_stat_database_blks_hit_total{job=\"postgres\"}) / (sum(pg_stat_database_blks_hit_total{job=\"postgres\"}) + sum(pg_stat_database_blks_read_total{job=\"postgres\"}))",
          "legendFormat": "Cache Hit Ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Dead Tuples",
      "gridPos": { "x": 8, "y": 8, "w": 16, "h": 6 },
      "id": 6,
      "datasource": null,
      "targets": [
        {
          "expr": "pg_stat_user_tables_n_dead_tup{job=\"postgres\"}",
          "legendFormat": "{{relname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisLabel": "dead tuples"
          },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Redis",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 },
      "id": 7,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Memory Used vs Max",
      "gridPos": { "x": 0, "y": 15, "w": 8, "h": 7 },
      "id": 8,
      "datasource": null,
      "targets": [
        {
          "expr": "redis_memory_used_bytes{job=\"redis\"}",
          "legendFormat": "Used",
          "refId": "A"
        },
        {
          "expr": "redis_memory_max_bytes{job=\"redis\"}",
          "legendFormat": "Max",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "axisLabel": "bytes"
          },
          "color": { "mode": "palette-classic" },
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Max" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Used" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Connected Clients",
      "gridPos": { "x": 8, "y": 15, "w": 8, "h": 7 },
      "id": 9,
      "datasource": null,
      "targets": [
        {
          "expr": "redis_connected_clients{job=\"redis\"}",
          "legendFormat": "Connected",
          "refId": "A"
        },
        {
          "expr": "redis_config_maxclients{job=\"redis\"}",
          "legendFormat": "Max Clients",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "axisLabel": "clients"
          },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Max Clients" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Operations per Second",
      "gridPos": { "x": 16, "y": 15, "w": 8, "h": 7 },
      "id": 10,
      "datasource": null,
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total{job=\"redis\"}[5m])",
          "legendFormat": "Ops/s",
          "refId": "A"
        },
        {
          "expr": "redis:ops_per_second:5m",
          "legendFormat": "Ops/s (recording rule)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "showPoints": "never",
            "axisLabel": "ops/s"
          },
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "gauge",
      "title": "Redis Hit Rate",
      "gridPos": { "x": 0, "y": 22, "w": 6, "h": 6 },
      "id": 11,
      "datasource": null,
      "targets": [
        {
          "expr": "redis:hit_rate:5m",
          "legendFormat": "Hit Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Hit / Miss Rate",
      "gridPos": { "x": 6, "y": 22, "w": 6, "h": 6 },
      "id": 12,
      "datasource": null,
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total{job=\"redis\"}[5m])",
          "legendFormat": "Hits/s",
          "refId": "A"
        },
        {
          "expr": "rate(redis_keyspace_misses_total{job=\"redis\"}[5m])",
          "legendFormat": "Misses/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "axisLabel": "ops/s"
          },
          "color": { "mode": "palette-classic" },
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Hits/s" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Misses/s" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Evicted Keys",
      "gridPos": { "x": 12, "y": 22, "w": 6, "h": 6 },
      "id": 13,
      "datasource": null,
      "targets": [
        {
          "expr": "rate(redis_evicted_keys_total{job=\"redis\"}[5m])",
          "legendFormat": "Evicted/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "axisLabel": "keys/s"
          },
          "color": { "fixedColor": "red", "mode": "fixed" },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Expired Keys",
      "gridPos": { "x": 18, "y": 22, "w": 6, "h": 6 },
      "id": 14,
      "datasource": null,
      "targets": [
        {
          "expr": "rate(redis_expired_keys_total{job=\"redis\"}[5m])",
          "legendFormat": "Expired/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "axisLabel": "keys/s"
          },
          "color": { "fixedColor": "yellow", "mode": "fixed" },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "type": "row",
      "title": "Prometheus",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 1 },
      "id": 15,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Scrape Duration by Job",
      "gridPos": { "x": 0, "y": 29, "w": 8, "h": 7 },
      "id": 16,
      "datasource": null,
      "targets": [
        {
          "expr": "scrape_duration_seconds",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisLabel": "seconds"
          },
          "color": { "mode": "palette-classic" },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "TSDB Storage Blocks Size",
      "gridPos": { "x": 8, "y": 29, "w": 8, "h": 7 },
      "id": 17,
      "datasource": null,
      "targets": [
        {
          "expr": "prometheus_tsdb_storage_blocks_bytes",
          "legendFormat": "Blocks Size",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "showPoints": "never",
            "axisLabel": "bytes"
          },
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Samples Appended Rate",
      "gridPos": { "x": 16, "y": 29, "w": 8, "h": 7 },
      "id": 18,
      "datasource": null,
      "targets": [
        {
          "expr": "rate(prometheus_tsdb_head_samples_appended_total[5m])",
          "legendFormat": "Samples/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "showPoints": "never",
            "axisLabel": "samples/s"
          },
          "color": { "fixedColor": "green", "mode": "fixed" },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    }
  ]
}
