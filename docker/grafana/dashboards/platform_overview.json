  "title": "Platform Overview",
  "description": "High-level health and performance overview of all Reveal Market services",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "refresh": "30s",
  "time": {
