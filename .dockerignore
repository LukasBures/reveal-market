# Ignore everything by default to keep build contexts slim
*

# Include service sources so Docker builds have access to code
!backend/
!frontend/
!hedger/
!streamer/
!relayer/
!contracts/cache/
!shared/
!pyproject.toml
!uv.lock
!run.py
!prover/
!docker/

# Allow top-level metadata files as needed
!.dockerignore
!README.md
!Makefile

# Ignore common build artifacts inside included directories
**/__pycache__/
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.venv/
**/node_modules/
**/.next/
**/.DS_Store
