# ------------------------------------------------------------------
# Shared Infrastructure (applies to Postgres, Redis, API, and worker)
# ------------------------------------------------------------------

########################################
# Global Defaults
########################################
MODE=prod
LOG_LEVEL=INFO

########################################
# Shared Infrastructure (DB, Redis, Rates)
########################################
RM_DATABASE_URL=postgresql+psycopg2://market_admin:<REDACTED>@postgres:5432/reveal_market
RM_REDIS_URL=redis://redis:6379/0
RM_RATE_LIMIT_ENABLED=false
RM_RATE_LIMIT_REQUESTS_PER_WINDOW=300
RM_RATE_LIMIT_WINDOW_SECONDS=60
RM_RATE_LIMIT_WHITELIST=

# FX feed used by API/worker/pricing/streamer
RM_FX_FEED_URL=https://gamma-api.polymarket.com/prices/zen-usd
RM_FX_TIMEOUT_SECONDS=5
RM_FX_FALLBACK_PRICE=1.0

# Economics (platform-wide)
RM_RAKE_PERCENT=0.02
RM_HAIRCUT_PERCENT=0.12
RM_WORSEN_PERCENT=0.03
RM_LP_SHARE_PERCENT=0.18

########################################
# Backend API (FastAPI, docker service `api`)
########################################
APP_WORKERS=1
RM_ENVIRONMENT=production
RM_ALLOWED_HOSTS=*
RM_CORS_ALLOW_ORIGINS=*
RM_CORS_ALLOW_METHODS=GET,HEAD,OPTIONS
RM_CORS_ALLOW_HEADERS=*
RM_CORS_ALLOW_CREDENTIALS=false
RM_ENABLE_SECURITY_HEADERS=true
RM_MARKET_CATEGORY_ALLOWLIST=
RM_CACHE_TTL_SECONDS=30
RM_CACHEABLE_MARKET_LIMIT=20
RM_MARKET_RECORD_CACHE_TTL_SECONDS=120
RM_CACHE_HYDRATE_ON_STARTUP=true
RM_CACHE_HYDRATE_LIMIT=20
RM_CACHE_REFRESH_ENABLED=true
RM_CACHE_REFRESH_INTERVAL_SECONDS=180
RM_CACHE_REFRESH_LIMIT=20
RM_CACHE_CONNECT_RETRIES=3
RM_CACHE_CONNECT_RETRY_DELAY_SECONDS=1.0
RM_FORCE_OFFLINE=false

########################################
# Worker (Polymarket ingestion, docker service `worker`)
########################################
RM_POLYMARKET_API_BASE=https://gamma-api.polymarket.com
RM_POLYMARKET_TIMEOUT_SECONDS=10
RM_POLYMARKET_ORDER=updatedAt
RM_POLYMARKET_SORT_ASCENDING=false
RM_POLYMARKET_PAGE_SIZE=
RM_POLYMARKET_MAX_PAGES=
RM_POLYMARKET_MAX_RETRIES=3
RM_POLYMARKET_RETRY_BACKOFF_SECONDS=0.2
RM_POLYMARKET_RETRY_BACKOFF_MAX_SECONDS=2
RM_POLYMARKET_CLOSED_FILTER=
RM_POLYMARKET_ACTIVE_FILTER=
RM_POLYMARKET_ARCHIVED_FILTER=
RM_POLYMARKET_NETWORK=
RM_POLYMARKET_RATE_LIMIT_REQUESTS=500
RM_POLYMARKET_RATE_LIMIT_WINDOW_SECONDS=8
RM_POLYMARKET_EMPTY_PAGE_TOLERANCE=2
RM_POLYMARKET_SYNC_MAX_ATTEMPTS=3
RM_POLYMARKET_SYNC_RETRY_BACKOFF_SECONDS=1
RM_POLYMARKET_SYNC_RETRY_BACKOFF_MAX_SECONDS=15
RM_POLL_INTERVAL_SECONDS=30
RM_HEARTBEAT_KEY=reveal_market_worker:heartbeat
RM_HEARTBEAT_TTL_SECONDS=120
RM_BATCH_STATS_KEY=reveal_market_worker:batch_stats
RM_BATCH_STATS_TTL_SECONDS=900
RM_API_BASE_URL=http://api:8000
RM_PRIME_MARKETS_CACHE_ENABLED=false
RM_MARKETS_CACHE_LIMIT=18
RM_MARKETS_CACHE_OFFSET=0
RM_MARKETS_CACHE_TTL_SECONDS=30
RM_CACHE_PRIME_TIMEOUT_SECONDS=5
RM_CATEGORY_CACHE_LIMIT=18
RM_SUGGEST_CACHE_LIMIT=5
RM_FEATURED_CATEGORIES=politics,sports,crypto
RM_FEATURED_SUGGEST_QUERIES="btc halving,gov shutdown"
RM_RESOLUTION_REFRESH_INTERVAL_SECONDS=300
RM_RESOLVED_RETENTION_SECONDS=86400
RM_RESOLVED_RETENTION_DRY_RUN=false
RM_SUMMARY_ENABLED=true
RM_SUMMARY_QUEUE_KEY=reveal_market_worker:summary_queue
RM_SUMMARY_DEAD_LETTER_KEY=reveal_market_worker:summary_dead_letter
RM_SUMMARY_REQUESTED_TTL_SECONDS=600
RM_SUMMARY_REFRESH_INTERVAL_SECONDS=604800
RM_SUMMARY_MIN_WORDS=200
RM_SUMMARY_MAX_WORDS=400
RM_SUMMARY_MODEL=gpt-5.1-mini
RM_SUMMARY_SOURCE_LABEL=ai_enrichment
RM_SUMMARY_API_BASE_URL=https://api.openai.com/v1
RM_SUMMARY_API_KEY=
RM_SUMMARY_HTTP_TIMEOUT_SECONDS=20
RM_SUMMARY_QUEUE_POLL_SECONDS=2
RM_SUMMARY_RETRY_BACKOFF_SECONDS=30
RM_SUMMARY_RETRY_MAX_ATTEMPTS=3
RM_SUMMARY_FALLBACK_ENABLED=true
RM_AUTO_CREATE_ONCHAIN_MARKETS=false
RM_DEFAULT_COMMIT_LEAD_SECONDS=86400
RM_DEFAULT_REVEAL_LEAD_SECONDS=172800
RM_RUN_MIGRATIONS_ON_STARTUP=true
RM_PROVER_ENABLED=false
RM_PROVER_BASE_URL=http://prover:8085
RM_PROVER_TIMEOUT_SECONDS=5
RM_PROOF_CACHE_PREFIX=reveal_market:proof_receipts
RM_PROOF_CACHE_TTL_SECONDS=86400

########################################
# Hedger (off-chain hedging)
########################################
HEDGER_DATABASE_URL=postgresql+psycopg2://market_admin:<REDACTED>@postgres:5432/reveal_market
HEDGER_REDIS_URL=redis://redis:6379/0
HEDGER_POLYMARKET_API_BASE=https://gamma-api.polymarket.com
HEDGER_FX_FEED_URL=https://gamma-api.polymarket.com/prices/zen-usd
HEDGER_FX_HAIRCUT_BPS=500
HEDGER_RISK_MAX_GLOBAL_EXPOSURE_USD=250000
HEDGER_RISK_MAX_PER_MARKET_USD=75000
HEDGER_FLOAT_MIN_ZEN=5000
HEDGER_PROVER_BASE_URL=http://prover:8085
HEDGER_BRIDGE_ENDPOINT=https://bridge.revealmarket.xyz/submit
HEDGER_LP_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
HEDGER_VAULT_RPC_URL=
HEDGER_VAULT_PRIVATE_KEY=
HEDGER_VAULT_SENDER_ADDRESS=
HEDGER_VAULT_CHAIN_ID=137
HEDGER_VAULT_GAS_PRICE_GWEI=

########################################
# Price Streamer (WS/SSE fanout)
########################################
STREAMER_REDIS_URL=redis://redis:6379/0
STREAMER_POLYMARKET_WS_URL=wss://clob.polymarket.com/ws
STREAMER_POLYMARKET_REST_URL=https://gamma-api.polymarket.com/markets
STREAMER_FX_FEED_URL=https://gamma-api.polymarket.com/prices/zen-usd
STREAMER_FX_TIMEOUT_SECONDS=5
STREAMER_FX_FALLBACK_PRICE=1.0
STREAMER_WORSEN_PERCENT=0.03
STREAMER_HAIRCUT_PERCENT=0.12
STREAMER_RAKE_PERCENT=0.02
STREAMER_API_HOST=0.0.0.0
STREAMER_API_PORT=8100

########################################
# Frontend (Next.js)
########################################
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
RM_OFFLINE_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=https://revealmarket.xyz
SITEMAP_API_BASE_URL=http://localhost:8000
LANDING_ACCESS_CODE=rm125
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=873dc26b73acc58f0d9a99ddc1c75dc6
NEXT_PUBLIC_WALLET_CHAINS=base
NEXT_PUBLIC_PRICE_STREAMER_URL=http://localhost:8100

########################################
# Goldsky / Indexer (shared)
########################################
RM_GOLDSKY_SUBGRAPH_URL=https://api.goldsky.com/api/public/project-id/subgraphs/conditional-tokens/1.0.0/gn
RM_GOLDSKY_API_KEY=<REDACTED>
RM_GOLDSKY_TIMEOUT_SECONDS=6

########################################
# On-chain / Contracts
########################################
RM_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
RM_MARKET_IMPLEMENTATION_ADDRESS=0x0000000000000000000000000000000000000000
RM_RAKE_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
RM_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
