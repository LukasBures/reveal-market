# -----------------------------
# Shared Infrastructure Defaults
# -----------------------------
# Runtime mode (prod/dev)
MODE=prod
# Global log level for services
LOG_LEVEL=INFO

# -----------------------------
# Caddy (TLS / Proxy)
# -----------------------------
# TLS profile (tls_prod uses HTTP/ALPN ACME, tls_dns uses Cloudflare DNS-01, tls_local uses internal CA)
CLOUDFLARE_API_TOKEN=

# -----------------------------
# Core DB/Redis & Rate Limits
# -----------------------------
# Postgres connection for API/worker/hedger
RM_DATABASE_URL=postgresql+psycopg2://market_admin:<REDACTED>@postgres:5432/reveal_market
# Redis connection for caches/locks/health
RM_REDIS_URL=redis://redis:6379/0
# Enable API rate limiting
RM_RATE_LIMIT_ENABLED=false
# Requests allowed per window
RM_RATE_LIMIT_REQUESTS_PER_WINDOW=300
# Rate limit window in seconds
RM_RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated IPs exempt from rate limits
RM_RATE_LIMIT_WHITELIST=

# FX feed used by API/worker/pricing (points to price-streamer inside Docker)
RM_FX_FEED_URL=http://price-streamer:8100/fx/zen-usd
# HTTP timeout for FX fetches
RM_FX_TIMEOUT_SECONDS=5
# FX fallback price if feeds fail
RM_FX_FALLBACK_PRICE=0.0
# Cache FX responses for this many seconds to avoid hammering upstream feeds
RM_FX_CACHE_TTL_SECONDS=60
# CORS allowed origins for price-streamer (browser-facing)
STREAMER_CORS_ALLOW_ORIGINS=["https://revealmarket.xyz","https://stream.revealmarket.xyz","http://localhost","http://localhost:3000","http://stream.localhost"]
# CORS allowed methods for price-streamer
STREAMER_CORS_ALLOW_METHODS=["GET","HEAD","OPTIONS"]
# CORS allowed headers for price-streamer
STREAMER_CORS_ALLOW_HEADERS=["*"]
# Allow credentials for price-streamer CORS
STREAMER_CORS_ALLOW_CREDENTIALS=false
# -----------------------------
# Platform Economics
# -----------------------------
# Rake percent (0.02 = 2%)
RM_RAKE_PERCENT=0.02
# Haircut percent applied to hedging
RM_HAIRCUT_PERCENT=0.12
# Worsen percent applied to displayed odds
RM_WORSEN_PERCENT=0.03
# LP revenue share percent
RM_LP_SHARE_PERCENT=0.18

# -----------------------------
# Backend API (FastAPI, service `api`)
# -----------------------------
# Uvicorn worker count
APP_WORKERS=1
# API environment label
RM_ENVIRONMENT=development
# Trusted hosts for Starlette (JSON list)
RM_ALLOWED_HOSTS=["localhost","127.0.0.1","localhost:3000","127.0.0.1:3000","api","api:8000","frontend","frontend:3000","price-streamer","price-streamer:8100","worker","hedger","prover"]
# CORS allowed origins (JSON list)
RM_CORS_ALLOW_ORIGINS=["https://revealmarket.xyz","https://stream.revealmarket.xyz","http://localhost","http://localhost:3000","http://api.localhost","http://stream.localhost"]
# CORS allowed methods
RM_CORS_ALLOW_METHODS=["GET","HEAD","OPTIONS"]
# CORS allowed headers
RM_CORS_ALLOW_HEADERS=["*"]
# CORS allow credentials
RM_CORS_ALLOW_CREDENTIALS=false
# Toggle security headers (CSP/HSTS/COOP)
RM_ENABLE_SECURITY_HEADERS=true
# Optional category allowlist (CSV)
RM_MARKET_CATEGORY_ALLOWLIST=
# Default cache TTL seconds
RM_CACHE_TTL_SECONDS=30
# Max markets cached per list
RM_CACHEABLE_MARKET_LIMIT=20
# TTL for individual market cache
RM_MARKET_RECORD_CACHE_TTL_SECONDS=120
# Warm caches on startup
RM_CACHE_HYDRATE_ON_STARTUP=true
# Max records to warm on startup
RM_CACHE_HYDRATE_LIMIT=20
# Enable periodic cache refresh
RM_CACHE_REFRESH_ENABLED=true
# Interval seconds for refresh
RM_CACHE_REFRESH_INTERVAL_SECONDS=180
# Limit per refresh batch
RM_CACHE_REFRESH_LIMIT=20
# Pricing quote signer (required for signed quotes)
RM_PRICING_SIGNER_PRIVATE_KEY=
# Chain id used when signing quotes (must match the chain serving the market contracts)
RM_PRICING_CHAIN_ID=
# Quote validity window in seconds
RM_PRICING_QUOTE_TTL_SECONDS=15
# Public address for pricing signer (used by contracts/deploy scripts)
PRICING_SIGNER_ADDRESS=
# Retry count for Redis connect
RM_CACHE_CONNECT_RETRIES=3
# Delay between Redis retries
RM_CACHE_CONNECT_RETRY_DELAY_SECONDS=1.0
# Force offline mode (disable external calls)
RM_FORCE_OFFLINE=false

# -----------------------------
# Worker (Polymarket ingestion, service `worker`)
# -----------------------------
# Polymarket Gamma base URL
RM_POLYMARKET_API_BASE=https://gamma-api.polymarket.com
# Polymarket HTTP timeout seconds
RM_POLYMARKET_TIMEOUT_SECONDS=10
# Polymarket sort field
RM_POLYMARKET_ORDER=updatedAt
# Sort ascending toggle
RM_POLYMARKET_SORT_ASCENDING=false
# Optional page size override
RM_POLYMARKET_PAGE_SIZE=
# Optional max pages override
RM_POLYMARKET_MAX_PAGES=
# Retry attempts for Gamma calls
RM_POLYMARKET_MAX_RETRIES=3
# Backoff seconds for Gamma retries
RM_POLYMARKET_RETRY_BACKOFF_SECONDS=0.2
# Max backoff seconds for Gamma
RM_POLYMARKET_RETRY_BACKOFF_MAX_SECONDS=2
# Filter: closed markets
RM_POLYMARKET_CLOSED_FILTER=
# Filter: active markets
RM_POLYMARKET_ACTIVE_FILTER=
# Filter: archived markets
RM_POLYMARKET_ARCHIVED_FILTER=
# Network id/name for Polymarket
RM_POLYMARKET_NETWORK=
# Gamma rate limit requests
RM_POLYMARKET_RATE_LIMIT_REQUESTS=500
# Gamma rate limit window seconds
RM_POLYMARKET_RATE_LIMIT_WINDOW_SECONDS=8
# Tolerated empty pages before stopping
RM_POLYMARKET_EMPTY_PAGE_TOLERANCE=2
# Max sync attempts per market
RM_POLYMARKET_SYNC_MAX_ATTEMPTS=3
# Backoff seconds between sync retries
RM_POLYMARKET_SYNC_RETRY_BACKOFF_SECONDS=1
# Max backoff seconds between sync retries
RM_POLYMARKET_SYNC_RETRY_BACKOFF_MAX_SECONDS=15
# Poll interval seconds for ingestion loop
RM_POLL_INTERVAL_SECONDS=30
# Redis heartbeat key for worker
RM_HEARTBEAT_KEY=reveal_market_worker:heartbeat
# TTL for worker heartbeat
RM_HEARTBEAT_TTL_SECONDS=120
# Redis key for batch stats
RM_BATCH_STATS_KEY=reveal_market_worker:batch_stats
# TTL for batch stats
RM_BATCH_STATS_TTL_SECONDS=900
# API base URL used by worker
RM_API_BASE_URL=http://api:8000
# Prime markets cache toggle
RM_PRIME_MARKETS_CACHE_ENABLED=false
# Prime markets cache limit
RM_MARKETS_CACHE_LIMIT=18
# Prime markets cache offset
RM_MARKETS_CACHE_OFFSET=0
# Prime markets cache TTL seconds
RM_MARKETS_CACHE_TTL_SECONDS=30
# Timeout seconds for cache priming
RM_CACHE_PRIME_TIMEOUT_SECONDS=5
# Category cache limit
RM_CATEGORY_CACHE_LIMIT=18
# Suggestions cache limit
RM_SUGGEST_CACHE_LIMIT=5
# Featured categories list
RM_FEATURED_CATEGORIES=politics,sports,crypto
# Featured suggest queries list
RM_FEATURED_SUGGEST_QUERIES="btc halving,gov shutdown"
# Resolution refresh interval seconds
RM_RESOLUTION_REFRESH_INTERVAL_SECONDS=300
# How long to keep resolved markets (seconds)
RM_RESOLVED_RETENTION_SECONDS=86400
# Dry run for resolved retention
RM_RESOLVED_RETENTION_DRY_RUN=false
# Enable AI summaries
RM_SUMMARY_ENABLED=true
# Redis queue key for summaries
RM_SUMMARY_QUEUE_KEY=reveal_market_worker:summary_queue
# Dead-letter key for summaries
RM_SUMMARY_DEAD_LETTER_KEY=reveal_market_worker:summary_dead_letter
# TTL for requested summaries
RM_SUMMARY_REQUESTED_TTL_SECONDS=600
# Summary refresh interval seconds
RM_SUMMARY_REFRESH_INTERVAL_SECONDS=604800
# Min words for summaries
RM_SUMMARY_MIN_WORDS=200
# Max words for summaries
RM_SUMMARY_MAX_WORDS=400
# Summary model name
RM_SUMMARY_MODEL=gpt-5.1-mini
# Summary source label
RM_SUMMARY_SOURCE_LABEL=ai_enrichment
# Summary API base URL
RM_SUMMARY_API_BASE_URL=https://api.openai.com/v1
# Summary API key
RM_SUMMARY_API_KEY=
# Summary HTTP timeout seconds
RM_SUMMARY_HTTP_TIMEOUT_SECONDS=20
# Poll interval seconds for summary queue
RM_SUMMARY_QUEUE_POLL_SECONDS=2
# Backoff seconds for summary retries
RM_SUMMARY_RETRY_BACKOFF_SECONDS=30
# Max attempts for summary retries
RM_SUMMARY_RETRY_MAX_ATTEMPTS=3
# Enable summary fallback behavior
RM_SUMMARY_FALLBACK_ENABLED=true
# Auto-create onchain markets toggle
RM_AUTO_CREATE_ONCHAIN_MARKETS=false
# Default commit lead time seconds
RM_DEFAULT_COMMIT_LEAD_SECONDS=86400
# Default reveal lead time seconds
RM_DEFAULT_REVEAL_LEAD_SECONDS=172800
# Run DB migrations on startup
RM_RUN_MIGRATIONS_ON_STARTUP=true
# Enable prover integration
RM_PROVER_ENABLED=false
# Prover base URL
RM_PROVER_BASE_URL=http://prover:8085
# Prover timeout seconds
RM_PROVER_TIMEOUT_SECONDS=5
# Redis prefix for proof receipts
RM_PROOF_CACHE_PREFIX=reveal_market:proof_receipts
# TTL seconds for proof cache
RM_PROOF_CACHE_TTL_SECONDS=86400

# -----------------------------
# Hedger (off-chain hedging)
# -----------------------------
# Hedger Postgres URL
HEDGER_DATABASE_URL=postgresql+psycopg2://market_admin:<REDACTED>@postgres:5432/reveal_market
# Hedger Redis URL
HEDGER_REDIS_URL=redis://redis:6379/0
# Polymarket base URL for hedger
HEDGER_POLYMARKET_API_BASE=https://gamma-api.polymarket.com
# FX feed URL hedger trusts
HEDGER_FX_FEED_URL=http://price_streamer:8100/fx/zen-usd
# FX haircut in basis points
HEDGER_FX_HAIRCUT_BPS=500
# Max global exposure in USD
HEDGER_RISK_MAX_GLOBAL_EXPOSURE_USD=250000
# Max per-market exposure in USD
HEDGER_RISK_MAX_PER_MARKET_USD=75000
# Minimum ZEN float before top-up
HEDGER_FLOAT_MIN_ZEN=5000
# Prover base URL for hedger
HEDGER_PROVER_BASE_URL=http://prover:8085
# Bridge endpoint for moving funds
HEDGER_BRIDGE_ENDPOINT=https://bridge.revealmarket.xyz/submit
# LP vault address
HEDGER_LP_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
# Vault RPC URL
HEDGER_VAULT_RPC_URL=
# Vault signer private key
HEDGER_VAULT_PRIVATE_KEY=
# Vault sender address
HEDGER_VAULT_SENDER_ADDRESS=
# Vault chain ID
HEDGER_VAULT_CHAIN_ID=137
# Gas price override for vault tx
HEDGER_VAULT_GAS_PRICE_GWEI=

# -----------------------------
# Price Streamer (WS/SSE fanout)
# -----------------------------
# Redis URL for price-streamer
STREAMER_REDIS_URL=redis://redis:6379/0
# Polymarket CLOB WS endpoint
STREAMER_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# Polymarket REST markets endpoint
STREAMER_CLOB_REST_MARKETS_URL=https://gamma-api.polymarket.com/markets
# FX primary WS (Binance ZEN/USDT ticker)
STREAMER_FX_WS_URL=wss://stream.binance.com:9443/ws/zenusdt@ticker
# FX REST fallback (Binance HTTP)
STREAMER_FX_FEED_URL=https://api.binance.com/api/v3/ticker/price?symbol=ZENUSDT
# FX secondary REST fallback (CryptoCompare)
STREAMER_FX_FEED_ALT_URL=https://min-api.cryptocompare.com/data/price?fsym=ZEN&tsyms=USD
# FX HTTP timeout seconds
STREAMER_FX_TIMEOUT_SECONDS=5
# FX WS stale TTL seconds
STREAMER_FX_WS_STALE_TTL_SECONDS=10
# Worsen percent applied server-side
STREAMER_WORSEN_PERCENT=0.03
# Haircut percent applied server-side
STREAMER_HAIRCUT_PERCENT=0.12
# Rake percent applied server-side
STREAMER_RAKE_PERCENT=0.02
# API bind host for streamer
STREAMER_API_HOST=0.0.0.0
# API port for streamer
STREAMER_API_PORT=8100
# Streamer log level
STREAMER_LOG_LEVEL=INFO

# -----------------------------
# Frontend (Next.js)
# -----------------------------
# Public API base URL for browser
NEXT_PUBLIC_API_BASE_URL=https://api.revealmarket.xyz
# Offline API base URL (SSR)
RM_OFFLINE_API_BASE_URL=https://api.revealmarket.xyz
# Site canonical URL
NEXT_PUBLIC_SITE_URL=https://revealmarket.xyz
# Sitemap fetch base URL
SITEMAP_API_BASE_URL=https://api.revealmarket.xyz
# Optional landing access code
LANDING_ACCESS_CODE=rm125
# WalletConnect project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=873dc26b73acc58f0d9a99ddc1c75dc6
# Enabled wallet chains (comma separated)
NEXT_PUBLIC_WALLET_CHAINS=base
# Public price-streamer URL (browser). Use HTTPS so the client upgrades to WSS automatically.
NEXT_PUBLIC_PRICE_STREAMER_URL=https://stream.revealmarket.xyz
# Internal streamer URL for server components
STREAMER_INTERNAL_URL=https://stream.revealmarket.xyz
# Next.js build worker count
NEXT_BUILD_WORKERS=1

# -----------------------------
# Prover (Groth16 service)
# -----------------------------
PROVER_VERSION=dev
PROVER_CIRCUIT_HASH=0x0
PROVER_BACKEND=groth16

# -----------------------------
# Goldsky / Indexer
# -----------------------------
# Goldsky subgraph URL
RM_GOLDSKY_SUBGRAPH_URL=https://api.goldsky.com/api/public/project-id/subgraphs/conditional-tokens/1.0.0/gn
# Goldsky API key
RM_GOLDSKY_API_KEY=<REDACTED>
# Goldsky HTTP timeout seconds
RM_GOLDSKY_TIMEOUT_SECONDS=6

# -----------------------------
# On-chain / Contracts
# -----------------------------
# MarketFactory address
RM_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
# Market implementation address
RM_MARKET_IMPLEMENTATION_ADDRESS=0x0000000000000000000000000000000000000000
# RakeManager address
RM_RAKE_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
# Verifier contract address
RM_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
# RPC URL for chain interactions
RM_RPC_URL=https://your-horizen-endpoint.example.com
# Wallet address for on-chain ops
RM_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
# Wallet private key for on-chain ops
RM_WALLET_PRIVATE_KEY=<REDACTED>
# Gas price override (gwei)
RM_GAS_PRICE_GWEI=2
# Max priority fee (gwei)
RM_MAX_PRIORITY_FEE_GWEI=2
