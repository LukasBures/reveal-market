# Core runtime configuration
MODE=dev
LOG_LEVEL=DEBUG
APP_WORKERS=2

# Database & cache
RM_DATABASE_URL=postgresql+psycopg2://market_admin:<REDACTED>@localhost:5432/reveal_market
RM_REDIS_URL=redis://localhost:6379/0

# Polymarket feed
RM_POLYMARKET_API_BASE=https://strapi-matic.poly.market/api/markets
RM_POLYMARKET_TIMEOUT_SECONDS=10
RM_POLL_INTERVAL_SECONDS=30
RM_POLYMARKET_PAGE_SIZE=100

# Worker heartbeat (stored in Redis)
RM_HEARTBEAT_KEY=reveal_market_worker:heartbeat
RM_HEARTBEAT_TTL_SECONDS=120
RM_AUTO_CREATE_ONCHAIN_MARKETS=false
RM_RESOLUTION_REFRESH_INTERVAL_SECONDS=300
RM_RUN_MIGRATIONS_ON_STARTUP=true

# Default deadlines for auto-created markets (in seconds)
RM_DEFAULT_COMMIT_LEAD_SECONDS=86400
RM_DEFAULT_REVEAL_LEAD_SECONDS=172800

# FastAPI metadata
RM_ENVIRONMENT=development

# -------------------------------------------------------------------
# Blockchain / Contracts (planned integration)
# -------------------------------------------------------------------
# Addresses of deployed contracts (update after deployments)
RM_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
RM_MARKET_IMPLEMENTATION_ADDRESS=0x0000000000000000000000000000000000000000
RM_RAKE_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
RM_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# Horizen / EVM RPC endpoint the backend/worker should use
RM_RPC_URL=https://your-horizen-endpoint.example.com

# Wallet used for market creation & administrative actions
RM_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
# Private key should be stored securely (e.g. .env.local / secret manager)
RM_WALLET_PRIVATE_KEY=<REDACTED>

# Optional: gas configuration
RM_GAS_PRICE_GWEI=2
RM_MAX_PRIORITY_FEE_GWEI=2
