# -----------------------------
# Shared Infrastructure Defaults (local/dev)
# -----------------------------
# Runtime environment (local/dev)
RM_ENVIRONMENT=local
# Global log level for services
LOG_LEVEL=INFO
# Public Turnstile token for Horizen testnet faucet automation (scripts/zen_testnet_faucet.py)
TURNSTILE_TOKEN=<REDACTED>

# -----------------------------
# Caddy (TLS / Proxy)
# -----------------------------
# TLS profile
CADDY_TLS_PROFILE=tls_local
# Cloudflare API token for DNS ACME (tls_prod)
CLOUDFLARE_API_TOKEN=

# -----------------------------
# Core DB/Redis & Rate Limits
# -----------------------------
# Sync driver for Alembic migrations (keep psycopg2 here)
RM_DATABASE_URL=postgresql+psycopg2://xxx:<REDACTED>@postgres:5432/reveal_market
# Async driver for runtime DB access (worker uses this for async engine)
RM_DATABASE_ASYNC_URL=postgresql+asyncpg://xxx:<REDACTED>@postgres:5432/reveal_market
# Redis auth password (update for non-local)
REDIS_PASSWORD=<REDACTED>
# Redis connection for caches/locks/health
RM_REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379/0"
# Enable API rate limiting
RM_RATE_LIMIT_ENABLED=false
# Requests allowed per window
RM_RATE_LIMIT_REQUESTS_PER_WINDOW=300
# Rate limit window in seconds
RM_RATE_LIMIT_WINDOW_SECONDS=60
# Whitelisted IP/CIDR for rate limit bypass
RM_RATE_LIMIT_WHITELIST=[]
# Trusted proxy IP/CIDR that may supply X-Forwarded-For for rate limiting
RM_RATE_LIMIT_TRUSTED_PROXIES=[]
# FX feed is hardcoded to streamer (/fx/zen-usd); env overrides are ignored.
RM_FX_FEED_URL=http://streamer:8100/fx/zen-usd
# HTTP timeout for FX fetches
RM_FX_TIMEOUT_SECONDS=5
# FX fallback price if feeds fail
RM_FX_FALLBACK_PRICE=0.0
# Cache FX responses for this many seconds to avoid hammering upstream feeds
RM_FX_CACHE_TTL_SECONDS=60

# -----------------------------
# Platform Economics
# -----------------------------
# Rake percent (0.02 = 2%)
RM_RAKE_PERCENT=0.02
# Haircut percent applied to hedging
RM_HAIRCUT_PERCENT=0.12
# Worsen percent applied to displayed odds
RM_WORSEN_PERCENT=0.03
# LP revenue share percent
RM_LP_SHARE_PERCENT=0.18
# Per-bet and cumulative caps (ZEN)
RM_MAX_STAKE_ZEN=0.1
RM_MAX_USER_STAKE_PER_MARKET_ZEN=1
RM_MAX_MARKET_STAKE_ZEN=5

# -----------------------------
# Backend API (FastAPI, service `api`)
# -----------------------------
# Uvicorn worker count
APP_WORKERS=4
# Trusted hosts (CSV, no wildcards in prod)
RM_ALLOWED_HOSTS=api.localhost,localhost,127.0.0.1,api,api:8000
# Toggle security headers (CSP/HSTS/COOP)
RM_ENABLE_SECURITY_HEADERS=true
# CORS allowlist (CSV, avoid "*" in prod)
RM_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1
# CORS methods/headers (include POST for pricing/submit/quote)
RM_CORS_ALLOW_METHODS=GET,HEAD,OPTIONS,POST
RM_CORS_ALLOW_HEADERS=*
# Internal API base URL (used by worker cache priming + frontend presets)
RM_API_BASE_URL=http://api:8000
# Host header for health checks (docker-compose)
RM_HEALTHCHECK_HOST=localhost
# Optional category allowlist (CSV)
# Default cache TTL seconds
RM_CACHE_TTL_SECONDS=30
# Max markets cached per list
RM_CACHEABLE_MARKET_LIMIT=500
# TTL for individual market cache
RM_MARKET_RECORD_CACHE_TTL_SECONDS=180
# Warm caches on startup
RM_CACHE_HYDRATE_ON_STARTUP=true
# Max records to warm on startup
RM_CACHE_HYDRATE_LIMIT=500
# Enable periodic cache refresh
RM_CACHE_REFRESH_ENABLED=true
# Interval seconds for refresh
RM_CACHE_REFRESH_INTERVAL_SECONDS=120
# Limit per refresh batch
RM_CACHE_REFRESH_LIMIT=500
# Pricing quote signer (required for signed quotes)
RM_PRICING_SIGNER_PRIVATE_KEY=
# Chain id used when signing quotes (must match the chain serving the market contracts)
RM_PRICING_CHAIN_ID=2651420
# Quote validity window in seconds
RM_PRICING_QUOTE_TTL_SECONDS=15
# Public address for pricing signer (used by contracts/deploy scripts)
PRICING_SIGNER_ADDRESS=
# Retry count for Redis connect
RM_CACHE_CONNECT_RETRIES=5
# Delay between Redis retries
RM_CACHE_CONNECT_RETRY_DELAY_SECONDS=2

# -----------------------------
# Worker (Polymarket ingestion, service `worker`)
# -----------------------------
# Polymarket Gamma base URL
RM_POLYMARKET_API_BASE=https://gamma-api.polymarket.com
# Polymarket HTTP timeout seconds
RM_POLYMARKET_TIMEOUT_SECONDS=10
# Polymarket sort field
RM_POLYMARKET_ORDER=updatedAt
# Sort ascending toggle
RM_POLYMARKET_SORT_ASCENDING=false
# Optional page size override
RM_POLYMARKET_PAGE_SIZE=150
# Optional max pages override
RM_POLYMARKET_MAX_PAGES=1000
# Retry attempts for Gamma calls
RM_POLYMARKET_MAX_RETRIES=3
# Backoff seconds for Gamma retries
RM_POLYMARKET_RETRY_BACKOFF_SECONDS=0.2
# Max backoff seconds for Gamma
RM_POLYMARKET_RETRY_BACKOFF_MAX_SECONDS=2
# Only open markets (true = open only)
RM_POLYMARKET_ONLY_OPEN_MARKETS=true
# Filter: active markets
RM_POLYMARKET_ACTIVE_FILTER=
# Filter: archived markets
RM_POLYMARKET_ARCHIVED_FILTER=
# Network id/name for Polymarket
RM_POLYMARKET_NETWORK=
# Gamma rate limit requests
RM_POLYMARKET_RATE_LIMIT_REQUESTS=500
# Gamma rate limit window seconds
RM_POLYMARKET_RATE_LIMIT_WINDOW_SECONDS=8
# Tolerated empty pages before stopping
RM_POLYMARKET_EMPTY_PAGE_TOLERANCE=2
# Max sync attempts per market
RM_POLYMARKET_SYNC_MAX_ATTEMPTS=3
# Backoff seconds between sync retries
RM_POLYMARKET_SYNC_RETRY_BACKOFF_SECONDS=1
# Max backoff seconds between sync retries
RM_POLYMARKET_SYNC_RETRY_BACKOFF_MAX_SECONDS=15
# Redis lease key to avoid multiple workers ingesting concurrently
RM_POLYMARKET_SYNC_LEASE_KEY=reveal_market_worker:polymarket_sync_lease
# TTL seconds for the ingest lease
RM_POLYMARKET_SYNC_LEASE_TTL_SECONDS=120
# Random jitter seconds added to the lease TTL
RM_POLYMARKET_SYNC_LEASE_JITTER_SECONDS=2
# Poll interval seconds for ingestion loop
RM_POLL_INTERVAL_SECONDS=300
# Jitter seconds added to poll interval to avoid stampedes
RM_POLL_INTERVAL_JITTER_SECONDS=3
# Stream Polymarket pages and persist in batches to reduce memory
RM_POLYMARKET_STREAM_PERSIST=false
# Redis heartbeat key for worker
RM_HEARTBEAT_KEY=reveal_market_worker:heartbeat
# TTL for worker heartbeat
RM_HEARTBEAT_TTL_SECONDS=900
# Redis key for batch stats
RM_BATCH_STATS_KEY=reveal_market_worker:batch_stats
# TTL for batch stats
RM_BATCH_STATS_TTL_SECONDS=900
# Prime markets cache toggle
RM_PRIME_MARKETS_CACHE_ENABLED=false
# Prime markets cache limit
RM_MARKETS_CACHE_LIMIT=18
# Prime markets cache offset
RM_MARKETS_CACHE_OFFSET=0
# Prime markets cache TTL seconds
RM_MARKETS_CACHE_TTL_SECONDS=30
# Timeout seconds for cache priming
RM_CACHE_PRIME_TIMEOUT_SECONDS=5
# Category cache limit
RM_CATEGORY_CACHE_LIMIT=18
# Suggestions cache limit
RM_SUGGEST_CACHE_LIMIT=5
# Resolution refresh interval seconds
RM_RESOLUTION_REFRESH_INTERVAL_SECONDS=300
# How long to keep resolved markets (seconds)
RM_RESOLVED_RETENTION_SECONDS=86400
# Dry run for resolved retention
RM_RESOLVED_RETENTION_DRY_RUN=false
# Auto-create onchain markets toggle
RM_AUTO_CREATE_ONCHAIN_MARKETS=false
# Default commit lead time seconds
RM_DEFAULT_COMMIT_LEAD_SECONDS=86400
# Default reveal lead time seconds
RM_DEFAULT_REVEAL_LEAD_SECONDS=172800
# Run DB migrations on startup
RM_RUN_MIGRATIONS_ON_STARTUP=false
# Prover base URL
RM_PROVER_BASE_URL=http://prover:8085
# Prover timeout seconds
RM_PROVER_TIMEOUT_SECONDS=5
# Optional shared secret for prover auth (sent as X-Prover-Secret)
RM_PROVER_SHARED_SECRET=
# Redis prefix for proof receipts
RM_PROOF_CACHE_PREFIX=reveal_market:proof_receipts
# TTL seconds for proof cache
RM_PROOF_CACHE_TTL_SECONDS=86400
# Redis queue keys for proof jobs
RM_PROOF_QUEUE_KEY=reveal_market_worker:proof_queue
RM_PROOF_QUEUE_DEDUPE_KEY=reveal_market_worker:proof_queue_dedupe
# Poll interval seconds for proof queue worker
RM_PROOF_QUEUE_POLL_SECONDS=1
# Max concurrent proof jobs processed by worker
RM_PROOF_QUEUE_MAX_CONCURRENCY=2
# Max depth before new proof jobs are backpressured
RM_PROOF_QUEUE_MAX_DEPTH=1000
# Dead-letter key for proof queue
RM_PROOF_QUEUE_DEAD_LETTER_KEY=reveal_market_worker:proof_queue_dead_letter
# Use relayer for lock-batches instead of direct RPC
RM_LOCK_BATCHES_USE_RELAYER=false
# Max markets to lock per worker tick
RM_LOCK_BATCHES_MAX_PER_TICK=3
# Relayer poll seconds when lock-batches returns a job id
RM_LOCK_BATCHES_RELAYER_POLL_SECONDS=2
# Max relayer poll attempts before giving up
RM_LOCK_BATCHES_RELAYER_MAX_ATTEMPTS=15
# Gas limit for lock-batches transactions (direct RPC)
RM_LOCK_BATCHES_GAS_LIMIT=800000
# Gas price override (gwei)
RM_LOCK_BATCHES_GAS_PRICE_GWEI=
# Priority fee override (gwei)
RM_LOCK_BATCHES_MAX_PRIORITY_FEE_GWEI=
# Redis queue keys for settlement jobs
RM_SETTLEMENT_QUEUE_KEY=reveal_market_worker:settlement_queue
# Dead-letter key for settlement queue
RM_SETTLEMENT_QUEUE_DEAD_LETTER_KEY=reveal_market_worker:settlement_queue_dead_letter
# Poll interval seconds for settlement queue worker
RM_SETTLEMENT_QUEUE_POLL_SECONDS=1
# Max concurrent settlement jobs processed by worker
RM_SETTLEMENT_QUEUE_MAX_CONCURRENCY=2

# -----------------------------
# Hedger (off-chain hedging)
# -----------------------------
# Hedger Redis URL
HEDGER_REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379/0"
# Polymarket base URL for hedger
HEDGER_POLYMARKET_API_BASE=https://gamma-api.polymarket.com
# FX feed URL hedger trusts (align with API/streamer)
HEDGER_FX_FEED_URL=http://streamer:8100/fx/zen-usd
# FX haircut in basis points
HEDGER_FX_HAIRCUT_BPS=500
# Max global exposure in USD
HEDGER_RISK_MAX_GLOBAL_EXPOSURE_USD=250000
# Max per-market exposure in USD
HEDGER_RISK_MAX_PER_MARKET_USD=75000
# Minimum ZEN float before top-up
HEDGER_FLOAT_MIN_ZEN=5000
# Prover base URL for hedger
HEDGER_PROVER_BASE_URL=http://prover:8085
# Optional shared secret for prover auth (sent as X-Prover-Secret)
HEDGER_PROVER_SHARED_SECRET=
# Bridge endpoint for moving funds
HEDGER_BRIDGE_ENDPOINT=https://bridge.revealmarket.xyz/submit
# LP vault address
HEDGER_LP_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
# Vault RPC URL (mainnet)
HEDGER_VAULT_RPC_URL=https://horizen-testnet.rpc.caldera.xyz/http
# Vault signer private key
HEDGER_VAULT_PRIVATE_KEY=<REDACTED>
# Vault sender address
HEDGER_VAULT_SENDER_ADDRESS=0x0000000000000000000000000000000000000000
# Vault chain ID (Polygon)
HEDGER_VAULT_CHAIN_ID=137
# Gas price override for vault tx
HEDGER_VAULT_GAS_PRICE_GWEI=20

# -----------------------------
# Streamer (WS/SSE fanout)
# -----------------------------
# Public streamer URL for browsers
STREAMER_PUBLIC_BASE_URL=http://streamer:8100
# Internal streamer URL for other services
STREAMER_INTERNAL_BASE_URL=http://streamer:8100
# Redis URL for streamer
STREAMER_REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379/0"
# Polymarket CLOB WS endpoint
STREAMER_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# Polymarket REST markets endpoint (optional for fallback seeding)
STREAMER_CLOB_REST_URL=https://clob.polymarket.com/markets
# FX primary WS (Binance ZEN/USDT ticker)
STREAMER_FX_PRIMARY_WS_URL=wss://stream.binance.com:9443/ws/zenusdt@ticker
# FX primary REST fallback (Binance HTTP)
STREAMER_FX_PRIMARY_REST_URL=https://api.binance.com/api/v3/ticker/price?symbol=ZENUSDT
# FX secondary REST fallback (CryptoCompare)
STREAMER_FX_SECONDARY_REST_URL=https://min-api.cryptocompare.com/data/price?fsym=ZEN&tsyms=USD
# Optional FX secondary WS (Polymarket RTDS crypto_prices)
# RTDS WS for Polymarket market data
STREAMER_RTDS_WS_URL=wss://ws-live-data.polymarket.com
# Enable RTDS market data
STREAMER_RTDS_ENABLED=false
# FX HTTP timeout seconds
STREAMER_FX_TIMEOUT_SECONDS=5
# FX WS stale TTL seconds
STREAMER_FX_WS_STALE_TTL_SECONDS=10
# Worsen percent applied server-side
STREAMER_WORSEN_PERCENT=0.03
# Haircut percent applied server-side
STREAMER_HAIRCUT_PERCENT=0.12
# Rake percent applied server-side
STREAMER_RAKE_PERCENT=0.02
# Publish market ticks when FX is stale (payloads include fx_stale flag)
STREAMER_PUBLISH_WHEN_FX_STALE=true
# API bind host for streamer
STREAMER_API_HOST=0.0.0.0
# API port for streamer
STREAMER_API_PORT=8100
# Streamer log level
STREAMER_LOG_LEVEL=INFO
# CORS allowed origins for streamer (browser-facing)
STREAMER_CORS_ALLOW_ORIGINS=["http://localhost:3000","http://stream.localhost","http://stream.localhost:8100"]
# CORS allowed methods for streamer
STREAMER_CORS_ALLOW_METHODS=["GET","HEAD","OPTIONS"]
# CORS allowed headers for streamer
STREAMER_CORS_ALLOW_HEADERS=["*"]
# Allow credentials for streamer CORS
STREAMER_CORS_ALLOW_CREDENTIALS=false

# -----------------------------
# Frontend (Next.js)
# -----------------------------
# Base API URL for frontend calls
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Public streamer URL used by the frontend
NEXT_PUBLIC_PRICE_STREAMER_URL=http://localhost:8100
# Public site URL (SEO/canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Analytics (leave empty to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional landing access code (empty = disabled)
LANDING_ACCESS_CODE=rm125
# WalletConnect project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=873dc26b73acc58f0d9a99ddc1c75dc6
# Enabled wallet chains (comma separated)
NEXT_PUBLIC_WALLET_CHAINS=base
# Next.js build worker count
NEXT_BUILD_WORKERS=8
# Default chain (Horizen testnet)
NEXT_PUBLIC_CHAIN_ID=2651420
NEXT_PUBLIC_CHAIN_NAME="Horizen Testnet"
NEXT_PUBLIC_RPC_URL=https://horizen-testnet.rpc.caldera.xyz/http
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://horizen-testnet.explorer.caldera.xyz
# ERC20 collateral token (ZEN)
NEXT_PUBLIC_ZEN_TOKEN_ADDRESS=0x070040A826B586b58569750ED43cb5979b171e8d
NEXT_PUBLIC_RELAYER_ESCROW_ADDRESS=0xF59AeA4DAbF81f0935FB57A077BcB8a1926F0476
# Cloudflare Turnstile (contact form)
CONTACT_TURNSTILE_SITE_KEY=
CONTACT_TURNSTILE_SECRET=
# SMTP (contact form email relay)
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
CONTACT_SMTP_SECURE=false
CONTACT_FROM=no-reply@revealmarket.xyz

# -----------------------------
# Prover (Groth16 service)
# -----------------------------
PROVER_VERSION=dev
PROVER_CIRCUIT_HASH=0x2b2543848202371becfdb6b246e0f2f8f6ffbed6509211007534f2bc2d5e77c9
PROVER_BACKEND=groth16
# Optional shared secret required for proof requests (X-Prover-Secret)
PROVER_SHARED_SECRET=
# SSH key path for pulling prover artifacts (optional)
PROVER_ARTIFACTS_SSH_KEY_PATH=

# -----------------------------
# Goldsky / Indexer
# -----------------------------
# Goldsky subgraph URL
RM_GOLDSKY_SUBGRAPH_URL=
# Goldsky API key (prod)
RM_GOLDSKY_API_KEY=
# Goldsky HTTP timeout seconds
RM_GOLDSKY_TIMEOUT_SECONDS=6

# -----------------------------
# On-chain / Contracts
# -----------------------------
# Network defaults (Horizen testnet)
RM_RPC_URL=https://horizen-testnet.rpc.caldera.xyz/http
RPC_URL=https://horizen-testnet.rpc.caldera.xyz/http
