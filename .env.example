# .env.example — Slim environment template for Reveal Market
# ============================================================
# Most configuration has DEFAULTS IN CODE (Pydantic BaseSettings + env_presets.py).
# This file contains ONLY: secrets, infrastructure URLs, contract addresses,
# and deployment-specific values. Copy to .env.local and fill in secrets.
#
# Tuning knobs (cache TTLs, poll intervals, batch sizes, memory thresholds, etc.)
# are not listed here — they default from code and resolve per-environment
# (local vs prod) via backend/shared/env_presets.py.
#
# For the full list of available overrides, see each service's config.py.
# ============================================================

# --- Core ---
# Required: "local" for development, "production" for prod (controls presets)
RM_ENVIRONMENT=local

# --- Infrastructure (Required) ---
REDIS_PASSWORD=<REDACTED>
RM_DATABASE_URL=postgresql+psycopg2://market_admin:<REDACTED>@postgres:5432/reveal_market
RM_DATABASE_ASYNC_URL=postgresql+asyncpg://market_admin:<REDACTED>@postgres:5432/reveal_market
# Redis URLs for each service (derived from REDIS_PASSWORD)
RM_REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379/0"
STREAMER_REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379/0"
HEDGER_REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379/0"

# --- Signing keys (Required — use dummy values for local dev) ---
RM_PRICING_SIGNER_PRIVATE_KEY=
RM_AUTHORIZATION_SIGNER_PRIVATE_KEY=
RM_WALLET_PRIVATE_KEY=
RM_SETTLEMENT_SIGNER_PRIVATE_KEY=
RM_RELAYER_PRIVATE_KEY=
HEDGER_VAULT_PRIVATE_KEY=
DEPLOYER_KEY=
E2E_USER_PRIVATE_KEY=
E2E_USER_ADDRESS=

# --- Internal auth tokens (Required in prod, can use dev values locally) ---
RM_RELAYER_BEARER_TOKEN=
RM_RELAYER_API_INTERNAL_SECRET=
RM_RELAYER_INTERNAL_SECRET=
RM_INTERNAL_API_SECRET=
RM_PROVER_SHARED_SECRET=
RM_HEDGER_INTERNAL_SECRET=
HEDGER_ADMIN_INTERNAL_SECRET=
GRAFANA_ADMIN_PASSWORD=<REDACTED>
# Optional: Cloudflare API token (required for prod TLS via Caddy DNS-01)
CF_API_TOKEN=

# --- Chain & contract addresses (Required) ---
RM_RPC_URL=https://horizen.calderachain.xyz/http
RM_CHAIN_ID=26514
RM_FACTORY_ADDRESS=
RM_PROTOCOL_POOL_ADDRESS=
RM_RELAYER_ESCROW_ADDRESS=
RM_MARKET_IMPLEMENTATION_ADDRESS=
RM_VERIFIER_ADDRESS=
RM_AUTHORIZATION_SIGNER=
RM_ORACLE_ADDRESS=
ZEN_TOKEN_ADDRESS=

# --- Frontend build-time vars ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_ZEN_TOKEN_ADDRESS=
NEXT_PUBLIC_RELAYER_ESCROW_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=26514
NEXT_PUBLIC_RPC_URL=https://horizen.calderachain.xyz/http
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://horizen.calderaexplorer.xyz
# Optional: Google Analytics (leave empty to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Prover ---
PROVER_CIRCUIT_HASH=
# Optional: SSH key for pulling prover artifacts submodule
PROVER_ARTIFACTS_SSH_KEY_PATH=

# --- Optional: Contact form (frontend) ---
CONTACT_TURNSTILE_SITE_KEY=
CONTACT_TURNSTILE_SECRET=
CONTACT_DISCORD_WEBHOOK_URL=

# --- Alertmanager / monitoring notifications (item 10) ---
# Discord webhook URL for Prometheus alert delivery via Alertmanager.
# Required in prod for alert notifications. Set via secrets manager, not plaintext.
DISCORD_ALERT_WEBHOOK_URL=
# Discord webhook URL for CI deploy success/failure notifications (cicd.yml).
DEPLOY_DISCORD_WEBHOOK_URL=
