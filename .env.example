# -----------------------------
CHAIN_ID=2651420
RELAYER_PRIVATE_KEY=<REDACTED>
RELAYER_ESCROW_ADDRESS=0xF59AeA4DAbF81f0935FB57A077BcB8a1926F0476
RELAYER_HOST=0.0.0.0
