# Core runtime configuration
# Settings that control how the API and worker boot, log, and scale.
# Deployment mode for shared services (typically prod, staging, or dev).
MODE=prod
# Minimum log level emitted by structured logging pipeline.
LOG_LEVEL=DEBUG
# Number of Gunicorn/Uvicorn worker processes to spawn for the API service.
APP_WORKERS=1

# Database & cache
# Connection strings for transactional storage and Redis-backed caching.
# SQLAlchemy-compatible Postgres DSN used by API and worker migrations.
RM_DATABASE_URL=postgresql+psycopg2://market_admin:<REDACTED>@localhost:5432/reveal_market
# Redis endpoint housing cache entries, heartbeat pings, and rate limiting keys.
RM_REDIS_URL=redis://localhost:6379/0

# Polymarket feed
# Tunables that shape how the worker ingests Polymarket markets.
# Base URL for Polymarket REST feed powering ingestion.
RM_POLYMARKET_API_BASE=https://gamma-api.polymarket.com
# Client-side timeout (seconds) for Polymarket HTTP requests.
RM_POLYMARKET_TIMEOUT_SECONDS=10
# Sleep interval (seconds) between worker sync passes.
RM_POLL_INTERVAL_SECONDS=30
# Page size requested per Polymarket API call.
RM_POLYMARKET_PAGE_SIZE=100
# Whether to include closed Polymarket markets in ingestion results.
RM_POLYMARKET_CLOSED_FILTER=false

# Frontend visibility filters (comma-separated)
# Allowlists that constrain which markets/categories/tags surface publicly.
# Comma-separated slugs for categories that should be rendered; empty allows all.
RM_MARKET_CATEGORY_ALLOWLIST=
# Comma-separated tags permitted in API responses; empty allows all tags.
RM_MARKET_TAG_ALLOWLIST=

# Worker heartbeat (stored in Redis)
# Keys + TTLs for heartbeat signals, cached responses, and featured content.
# Redis key storing last worker heartbeat timestamp for health reporting.
RM_HEARTBEAT_KEY=reveal_market_worker:heartbeat
# Expiration window (seconds) before the heartbeat is considered stale.
RM_HEARTBEAT_TTL_SECONDS=120
# Redis key capturing last batch processing stats for observability dashboards.
RM_BATCH_STATS_KEY=reveal_market_worker:batch_stats
# TTL (seconds) for batch stats records to avoid stale telemetry.
RM_BATCH_STATS_TTL_SECONDS=900
# Base URL the worker uses to call internal API endpoints.
RM_API_BASE_URL=http://api:8000
# Toggles whether the worker should maintain precomputed featured markets cache.
RM_PRIME_MARKETS_CACHE_ENABLED=true
# Max number of featured markets cached per refresh cycle.
RM_MARKETS_CACHE_LIMIT=18
# Offset applied when prefetching featured markets (0 fetches from start).
RM_MARKETS_CACHE_OFFSET=0
# TTL (seconds) for the featured markets cache entries.
RM_MARKETS_CACHE_TTL_SECONDS=30
# Timeout (seconds) for the prime markets cache warmup call to API.
RM_CACHE_PRIME_TIMEOUT_SECONDS=5
# Max categories kept in cache for category-filtered pages.
RM_CATEGORY_CACHE_LIMIT=18
# Max tags cached to serve tag-based filtering quickly.
RM_TAG_CACHE_LIMIT=18
# Max suggestions preserved when caching search queries.
RM_SUGGEST_CACHE_LIMIT=5
# Default list of categories highlighted on the homepage.
RM_FEATURED_CATEGORIES=politics,sports,crypto
# Tag phrases highlighted on the homepage hero modules (wrap the list in quotes when using spaces).
RM_FEATURED_TAGS="btc halving,ai regulation"
# Search queries seeded into the featured suggestions row (wrap the list in quotes when using spaces).
RM_FEATURED_SUGGEST_QUERIES="btc halving,gov shutdown"
# Enables automatic creation of on-chain markets aligned with Polymarket feed entries.
RM_AUTO_CREATE_ONCHAIN_MARKETS=false
# Interval (seconds) between worker passes that refresh resolution data.
RM_RESOLUTION_REFRESH_INTERVAL_SECONDS=300
# Determines if migrations should run automatically at service startup.
RM_RUN_MIGRATIONS_ON_STARTUP=true
# Duration (seconds) to keep resolved market data cached before cleanup.
RM_RESOLVED_RETENTION_SECONDS=86400
# Dry-run flag for resolved market cleanup logic (logs instead of deleting when true).
RM_RESOLVED_RETENTION_DRY_RUN=false

# Default deadlines for auto-created markets (in seconds)
# Lead times configuring commit/reveal windows for any on-chain markets we spawn.
# Seconds between market creation and commit cutoff when auto-creating markets.
RM_DEFAULT_COMMIT_LEAD_SECONDS=86400
# Seconds between commit cutoff and reveal deadline for auto-created markets.
RM_DEFAULT_REVEAL_LEAD_SECONDS=172800

# FastAPI metadata
# Values pushed into OpenAPI docs and metrics tags.
# Environment label attached to FastAPI telemetry and metadata.
RM_ENVIRONMENT=production

# Frontend / Next.js configuration
# URLs consumed by the marketing/docs site for API access and canonical docs hostnames.
# Public base URL Next.js uses to reach the backend API in browser + server contexts.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# -------------------------------------------------------------------
# Blockchain / Contracts (planned integration)
# -------------------------------------------------------------------
# Addresses of deployed contracts (update after deployments)
# Address of the MarketFactory contract controlling deployment of markets.
RM_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
# Address for the implementation logic used by proxy-based market instances.
RM_MARKET_IMPLEMENTATION_ADDRESS=0x0000000000000000000000000000000000000000
# RakeManager contract address governing fee splits.
RM_RAKE_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
# zk-SNARK verifier contract address required for proof verification.
RM_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# Horizen / EVM RPC endpoint the backend/worker should use
# RPC URL leveraged for submitting transactions and reading chain state.
RM_RPC_URL=https://your-horizen-endpoint.example.com

# Wallet used for market creation & administrative actions
# Public address used when signing ownership / admin transactions.
RM_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
# Private key should be stored securely (e.g. .env.local / secret manager)
# Hex-encoded private key for the admin wallet (never commit a real key).
RM_WALLET_PRIVATE_KEY=<REDACTED>

# Optional: gas configuration
# Gas price hints (gwei) when auto-submitting transactions.
# Base gas price to include when building on-chain transactions.
RM_GAS_PRICE_GWEI=2
# Priority fee (tip) in gwei to speed up transaction inclusion.
RM_MAX_PRIORITY_FEE_GWEI=2
