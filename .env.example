# .env.example — Secrets-only template for Reveal Market
# ============================================================
# This file contains ONLY secrets: credentials, private keys, tokens,
# and webhook URLs. Copy to .env.local and fill in values.
#
# Non-secret configuration (chain config, contract addresses, service URLs,
# tuning knobs) lives in docker-compose.yml / docker-compose.prod.yml and
# defaults from code (Pydantic BaseSettings + env_presets.py).
#
# For the full list of available overrides, see each service's config.py.
# ============================================================

# --- Core ---
ENV_FILE=.env.local

# --- Infrastructure (Required) ---
REDIS_PASSWORD=<REDACTED>
RM_DATABASE_URL=postgresql+psycopg2://market_admin:<REDACTED>@postgres:5432/reveal_market
RM_DATABASE_ASYNC_URL=postgresql+asyncpg://market_admin:<REDACTED>@postgres:5432/reveal_market
# Redis URLs for each service (derived from REDIS_PASSWORD)
RM_REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379/0"
STREAMER_REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379/0"
HEDGER_REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379/0"

# --- Signing keys (Required — use dummy values for local dev) ---
RM_PRICING_SIGNER_PRIVATE_KEY=
RM_AUTHORIZATION_SIGNER_PRIVATE_KEY=
RM_WALLET_PRIVATE_KEY=
RM_SETTLEMENT_SIGNER_PRIVATE_KEY=
RM_RELAYER_PRIVATE_KEY=
HEDGER_VAULT_PRIVATE_KEY=
DEPLOYER_KEY=
E2E_USER_PRIVATE_KEY=
E2E_USER_ADDRESS=

# --- Internal auth tokens (Required in prod, can use dev values locally) ---
RM_RELAYER_BEARER_TOKEN=
RM_RELAYER_API_INTERNAL_SECRET=
RM_RELAYER_INTERNAL_SECRET=
RM_INTERNAL_API_SECRET=
RM_PROVER_SHARED_SECRET=
RM_HEDGER_INTERNAL_SECRET=
HEDGER_ADMIN_INTERNAL_SECRET=
HEDGER_PROVER_SHARED_SECRET=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# Optional: Cloudflare API token (required for prod TLS via Caddy DNS-01)
CF_API_TOKEN=

# --- Frontend (embedded in client JS bundle) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Production overrides for frontend build (required for docker buildx bake).
# docker-bake.hcl defaults to localhost; set these in .env.production.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_PRICE_STREAMER_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_RM_ENVIRONMENT=

# --- External service secrets ---
CONTACT_TURNSTILE_SECRET=
CONTACT_DISCORD_WEBHOOK_URL=

# --- Relayer webhook ---
RM_RELAYER_WEBHOOK_SECRET=

# --- Alertmanager / monitoring notifications ---
# Discord webhook URL for Prometheus alert delivery via Alertmanager.
# Required in prod for alert notifications.
DISCORD_ALERT_WEBHOOK_URL=
# Discord webhook URL for CI deploy success/failure notifications (cicd.yml).
DEPLOY_DISCORD_WEBHOOK_URL=
